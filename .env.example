# SupportAI Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supportai_db
POSTGRES_PORT=5433

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/supportai_db
BACKEND_PORT=8000

# External ML/NLP Services (optional, falls back to local mock if empty or unreachable)
NLP_SERVICE_URL=
RETRIEVAL_SERVICE_URL=
RAG_SERVICE_URL=

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
